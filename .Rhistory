# ------------------------------------------------------------
# Sequential audit
# ------------------------------------------------------------
sequential_audit_simple <- function(
Mechanism, x1, x2, M_burn, h, eta_search_max,
claimed_curve, q_alpha,
max_iter = 10000L, eval_step = 10L
) {
refit <- function(P, Q) {
tmin <- min(P, Q)
tmax <- max(P, Q)
gs   <- min(1000L, length(P) %/% 10L)
bwP <- dpik(P, kernel = "normal", gridsize = gs, range.x = c(tmin, tmax))
bwQ <- dpik(Q, kernel = "normal", gridsize = gs, range.x = c(tmin, tmax))
KP <- bkde(P, kernel = "normal", bandwidth = bwP,
gridsize = gs, range.x = c(tmin, tmax))
KQ <- bkde(Q, kernel = "normal", bandwidth = bwQ,
gridsize = gs, range.x = c(tmin, tmax))
hat_p <- KP$y
hat_q <- KQ$y
gw <- KP$x[2] - KP$x[1]
eps <- 1e-16
log_lr <- log(hat_p + eps) - log(hat_q + eps)
xv   <- seq(-h/2, h/2, length.out = 1000)
etas <- seq(0, eta_search_max, length.out = 1000)
a <- sapply(etas, alpha_value, xv, h, gw, hat_p, log_lr)
b <- sapply(etas, beta_value,  xv, h, gw, hat_q, log_lr)
ok <- which(a > 0 & b <= 1)
if (!length(ok)) return(NULL)
eta_star <- {
d <- numeric(length(ok))
for (i in seq_along(ok)) {
a0 <- a[ok][i]
b0 <- b[ok][i]
f45 <- function(a_) claimed_curve(a_) - (b0 + (a_ - a0))
r <- tryCatch(uniroot(f45, c(0, 1))$root, error = function(e) NA)
if (!is.na(r)) {
b_ <- claimed_curve(r)
d[i] <- sqrt((r - a0)^2 + (b_ - b0)^2)
} else d[i] <- NA
}
if (all(is.na(d))) NA else etas[ok][which.max(d)]
}
fP_raw <- approxfun(KP$x, KP$y, rule = 2)
fQ_raw <- approxfun(KQ$x, KQ$y, rule = 2)
fP <- function(z) pmax(fP_raw(z), 0)
fQ <- function(z) pmax(fQ_raw(z), 0)
list(
tradeoff = data.frame(alpha = a, beta = b, eta = etas),
eta_star = eta_star,
classify = function(z) {
log(fQ(z) + eps) - log(fP(z) + eps) > log(eta_star)
}
)
}
eval_full <- function(P, Q, classify, q_alpha, M_burn, n) {
e1 <- classify(P)
e2 <- classify(Q)
T1 <- mean(e1)
T2 <- 1 - mean(e2)
s1 <- sqrt(T1 * (1 - T1))
s2 <- sqrt(T2 * (1 - T2))
bump <- sqrt(log(20 + n / M_burn)) / sqrt(n)
T1_ <- min(1, max(0, T1 + q_alpha * s1 * bump))
T2_ <- min(1, max(0, T2 + q_alpha * s2 * bump))
c(T1 = T1, T2 = T2,
T1_ = T1_, T2_ = T2_,
beta_allowed = claimed_curve(T1_))
}
P <- replicate(M_burn, Mechanism(x1))
Q <- replicate(M_burn, Mechanism(x2))
n <- M_burn
atk <- refit(P, Q)
comp <- eval_full(P, Q, atk$classify, q_alpha, M_burn, n)
if (comp["T2_"] < comp["beta_allowed"]) {
return(list(violation = 1, stopped_at_n = n,
comp = comp, tradeoff = atk$tradeoff))
}
while (n < M_burn + max_iter) {
P <- c(P, replicate(eval_step, Mechanism(x1)))
Q <- c(Q, replicate(eval_step, Mechanism(x2)))
n <- n + eval_step
atk <- refit(P, Q)
comp <- eval_full(P, Q, atk$classify, q_alpha, M_burn, n)
if (comp["T2_"] < comp["beta_allowed"]) {
return(list(violation = 1, stopped_at_n = n,
comp = comp, tradeoff = atk$tradeoff))
}
}
list(violation = 0, stopped_at_n = n,
comp = comp, tradeoff = atk$tradeoff)
}
# ------------------------------------------------------------
# Example run + plot
# ------------------------------------------------------------
source("src/mechanisms.R")
x1 <- rep(0, 10)
x2 <- c(1, rep(0, 9))
Mechanism <- make_sum_gauss(sigma = 1)
mu_val <- 0.5
claimed_curve <- function(alpha) {
pnorm(qnorm(1 - alpha) - mu_val)
}
claimed_curve_1 <- function(alpha) {
pnorm(qnorm(1 - alpha) - 1)
}
q_alpha <- simulate_gaussian_sup_quantile(M = 100, alpha = 0.025)
res <- sequential_audit_simple(
Mechanism, x1, x2,
M_burn = 100,
h = 0.1,
eta_search_max = 15,
claimed_curve = claimed_curve,
q_alpha = q_alpha
)
print(res$comp)
# ------------------------------------------------------------
# Plot trade-off curve
# ------------------------------------------------------------
curve_df <- res$tradeoff
plot(curve_df$alpha, curve_df$beta,
type = "l", lwd = 2,
xlab = expression(alpha),
ylab = expression(beta),
main = "Estimated Trade-off Curve")
alpha_grid <- seq(0, 1, length.out = 500)
lines(alpha_grid, claimed_curve(alpha_grid),
col = "red", lty = 2, lwd = 2)
lines(alpha_grid, claimed_curve(alpha_grid),
col = "green", lty = 2, lwd = 2)
lines(alpha_grid, claimed_curve_1(alpha_grid),
col = "green", lty = 2, lwd = 2)
points(res$comp["T1"], res$comp["T2"],
pch = 19, col = "blue")
legend("topright",
legend = c("Estimated trade-off",
"Claimed curve",
"Chosen point"),
col = c("black", "red", "blue"),
lty = c(1, 2, NA),
pch = c(NA, NA, 19),
lwd = c(2, 2, NA))
points(res$comp["T1_"], res$comp["T2_"],
pch = 19, col = "blue")
res <- sequential_audit_simple(
Mechanism, x1, x2,
M_burn = 100,
h = 0.1,
eta_search_max = 15,
claimed_curve = claimed_curve,
q_alpha = q_alpha
)
print(res$comp)
# ------------------------------------------------------------
# Plot trade-off curve
# ------------------------------------------------------------
curve_df <- res$tradeoff
plot(curve_df$alpha, curve_df$beta,
type = "l", lwd = 2,
xlab = expression(alpha),
ylab = expression(beta),
main = "Estimated Trade-off Curve")
alpha_grid <- seq(0, 1, length.out = 500)
lines(alpha_grid, claimed_curve(alpha_grid),
col = "red", lty = 2, lwd = 2)
lines(alpha_grid, claimed_curve_1(alpha_grid),
col = "green", lty = 2, lwd = 2)
points(res$comp["T1_"], res$comp["T2_"],
pch = 19, col = "blue")
legend("topright",
legend = c("Estimated trade-off",
"Claimed curve",
"Chosen point"),
col = c("black", "red", "blue"),
lty = c(1, 2, NA),
pch = c(NA, NA, 19),
lwd = c(2, 2, NA))
res <- sequential_audit_simple(
Mechanism, x1, x2,
M_burn = 100,
h = 0.1,
eta_search_max = 15,
claimed_curve = claimed_curve,
q_alpha = q_alpha
)
print(res$comp)
